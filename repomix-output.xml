<file path="auth.config.ts">
import type { NextAuthConfig } from "next-auth";

/**
 * Edge-safe NextAuth configuration.
 *
 * IMPORTANT: This file is shared between `auth.ts` (Node.js runtime) and
 * `middleware.ts` (Edge runtime). It must NOT import Prisma, the Prisma
 * adapter, or `@/utils/db` — Edge middleware cannot query the database.
 *
 * The full configuration lives in `auth.ts`, which spreads this config and
 * adds the PrismaAdapter + OAuth providers.
 */
export const authConfig = {
  pages: {
    signIn: "/sign-in",
  },
  providers: [], // Providers are added in auth.ts (Node.js runtime only)
  session: {
    strategy: "jwt",
  },
  callbacks: {
    /**
     * Route protection for the middleware. Runs in the Edge runtime with the
     * JWT session decoded from the `authjs.session-token` cookie.
     *
     * Return values:
     *  - `true`              → allow the request
     *  - `false`             → redirect to `pages.signIn`
     *  - `Response`          → use the response as-is (e.g. custom redirect)
     */
    authorized({ auth, request: { nextUrl } }) {
      const isLoggedIn = !!auth?.user;

      const protectedRoutes = [
        "/admin",
        "/checkout",
        "/orders",
        "/profile",
        "/user-profile",
        "/cart",
        "/favorites",
        "/reviews",
      ];
      const isProtectedRoute = protectedRoutes.some((path) =>
        nextUrl.pathname.startsWith(path)
      );

      if (isProtectedRoute && !isLoggedIn) {
        const loginUrl = new URL("/sign-in", nextUrl.origin);
        loginUrl.searchParams.set("redirect_url", nextUrl.pathname);
        return Response.redirect(loginUrl);
      }

      return true;
    },
  },
} satisfies NextAuthConfig;
</file>

<file path="auth.ts">
import NextAuth from "next-auth";
import Google from "next-auth/providers/google";
import { PrismaAdapter } from "@auth/prisma-adapter";
import db from "@/utils/db";
import { authConfig } from "./auth.config";

/**
 * NextAuth.js v5 (Auth.js) — central configuration.
 *
 * - `PrismaAdapter(db)` persists `User` / `Account` rows in PostgreSQL.
 * - `session.strategy = "jwt"` is REQUIRED here: when an adapter is present
 *   Auth.js would otherwise default to `database` sessions, which cannot be
 *   verified inside Edge `middleware.ts` (no DB access in the Edge runtime).
 *   With JWT sessions the middleware `authorized` callback works, and
 *   `session.user.id` below is still the Prisma `User.id` (read from
 *   `token.sub`, the user id the adapter stored in the `User` table).
 *
 * You can add more providers, e.g. GitHub, by uncommenting below:
 *   import GitHub from "next-auth/providers/github";
 *   providers: [Google, GitHub],
 */
export const { handlers, auth, signIn, signOut } = NextAuth({
  ...authConfig,
  trustHost: true,
  adapter: PrismaAdapter(db),
  providers: [Google],
  callbacks: {
    ...authConfig.callbacks,
    // Attach the DB user id to the session so Server Components / Server
    // Actions can query Prisma with `session.user.id`.
    session({ session, token }) {
      if (session.user) {
        session.user.id = token.sub as string;
      }
      return session;
    },
  },
});
</file>

